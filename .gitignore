*
!/.gitignore
!/reporter.cpp
!/reporter.rc
!/start_commands.txt
!/android/
!/android/**
!/web/
!/web/main.py
!/web/full_simulator.py
!/web/requirements.txt
!/web/start_commands.txt
!/web/templates/
!/web/templates/**
!/web/static/
!/web/static/**
!/README.md
!/web/**
!/system/
!/system/**

# Ignore generated web/ artifacts and environment files
/web/venv/
/web/__pycache__/
/web/*.db
/web/*.db-shm
/web/*.db-wal
/web/*.log
/web/nohup.out

# Ignore common generated files in the repository root
venv/
__pycache__/
*.db
*.pyc
.env
.DS_Store
.idea/
.gradle/
.vscode/

# Ignore generated build trees and local Android outputs
/build/
/build_*/
/android/**/build/
/cmake-build-*/
/out/
/system/bin/updater
/system/priv-app/*/*.idsig
